<file path="lib/features/challenges/shake_counter.dart">
import 'dart:math';

/// Logika murni penghitung kocokan (tanpa Flutter/sensor) agar mudah diuji.
///
/// Satu kocokan terhitung jika besar percepatan (m/s², tanpa gravitasi)
/// melewati [threshold] dan sudah lewat [minGap] sejak kocokan sebelumnya.
/// Jeda minimum mencegah satu ayunan terhitung berkali-kali.
class ShakeCounter {
  ShakeCounter({
    required this.target,
    this.threshold = 12.0,
    this.minGap = const Duration(milliseconds: 300),
  }) : assert(target > 0);

  static const minTarget = 10;
  static const maxTarget = 25;

  /// Target acak 10..25 (inklusif).
  static int randomTarget([Random? random]) =>
      minTarget + (random ?? Random()).nextInt(maxTarget - minTarget + 1);

  final int target;
  final double threshold;
  final Duration minGap;

  int _count = 0;
  int? _lastShakeMs;

  int get count => _count;
  bool get isDone => _count >= target;

  /// Memproses satu sampel. Mengembalikan true jika sampel ini menambah hitungan.
  bool addSample({
    required double x,
    required double y,
    required double z,
    required int timestampMs,
  }) {
    if (isDone) return false;
    final magnitude = sqrt(x * x + y * y + z * z);
    if (magnitude < threshold) return false;
    final last = _lastShakeMs;
    if (last != null && timestampMs - last < minGap.inMilliseconds) {
      return false;
    }
    _lastShakeMs = timestampMs;
    _count++;
    return true;
  }
}
</file>

<file path="lib/features/chat/chat_providers.dart">
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../profile/profile_providers.dart';
import 'chat_service.dart';

final chatServiceProvider = Provider<ChatService>((ref) => ChatService());

class ChatState {
  const ChatState({this.messages = const [], this.sending = false, this.error});

  final List<ChatMessage> messages;
  final bool sending;

  /// Pesan kesalahan untuk pengguna; pesan terakhir pengguna tetap ada agar
  /// bisa dicoba lagi.
  final String? error;
}

/// Percakapan disimpan di memori per pengguna: ganti akun atau logout menghapusnya.
class ChatNotifier extends Notifier<ChatState> {
  @override
  ChatState build() {
    ref.watch(currentUserIdProvider);
    return const ChatState();
  }

  Future<void> send(String text) async {
    final t = text.trim();
    if (t.isEmpty || state.sending) return;
    state = ChatState(
      messages: [...state.messages, ChatMessage(text: t, fromUser: true)],
      sending: true,
    );
    await _ask();
  }

  /// Mengulang permintaan terakhir setelah gagal.
  Future<void> retry() async {
    if (state.sending || state.messages.isEmpty || !state.messages.last.fromUser) {
      return;
    }
    state = ChatState(messages: state.messages, sending: true);
    await _ask();
  }

  void clear() => state = const ChatState();

  Future<void> _ask() async {
    final sentFor = ref.read(currentUserIdProvider);
    final history = state.messages;
    final profile = ref.read(profileProvider);
    try {
      final answer = await ref
          .read(chatServiceProvider)
          .reply(
            history,
            buildSystemPrompt(
              role: profile?.role,
              timezone: profile?.homeTimezone,
              currency: profile?.mainCurrency,
            ),
          );
      // Pengguna ganti akun atau menghapus percakapan saat menunggu: buang jawabannya.
      if (!ref.mounted || sentFor != ref.read(currentUserIdProvider)) return;
      if (state.messages.length != history.length) return;
      state = ChatState(
        messages: [...history, ChatMessage(text: answer, fromUser: false)],
      );
    } catch (_) {
      if (!ref.mounted || state.messages.length != history.length) return;
      state = ChatState(
        messages: history,
        error: 'Asisten sedang tidak bisa menjawab. '
            'Periksa koneksi internet lalu coba lagi.',
      );
    }
  }
}

final chatProvider = NotifierProvider<ChatNotifier, ChatState>(
  ChatNotifier.new,
);
</file>

<file path="lib/features/chat/chat_service.dart">
import 'dart:convert';

import 'package:http/http.dart' as http;

import '../../core/env.dart';
import '../cafes/cafe_llm_service.dart';

/// Satu pesan dalam percakapan. [fromUser] false = jawaban AI.
class ChatMessage {
  const ChatMessage({required this.text, required this.fromUser});

  final String text;
  final bool fromUser;
}

/// Maksimum pesan terakhir yang dikirim ke AI agar permintaan tetap ringan.
const chatHistoryLimit = 20;

/// Isi permintaan generateContent untuk percakapan. Fungsi murni.
Map<String, dynamic> buildChatBody(
  List<ChatMessage> history,
  String systemPrompt, {
  bool lowThinking = true,
}) {
  final recent = history.length > chatHistoryLimit
      ? history.sublist(history.length - chatHistoryLimit)
      : history;
  return {
    'systemInstruction': {
      'parts': [
        {'text': systemPrompt},
      ],
    },
    'contents': [
      for (final m in recent)
        {
          'role': m.fromUser ? 'user' : 'model',
          'parts': [
            {'text': m.text},
          ],
        },
    ],
    'generationConfig': {
      'temperature': 0.6,
      if (lowThinking) 'thinkingConfig': {'thinkingLevel': 'low'},
    },
  };
}

/// Instruksi sistem chatbot; [role], [timezone], [currency] dari profil pengguna
/// (boleh kosong).
String buildSystemPrompt({String? role, String? timezone, String? currency}) {
  final who = [
    if (role != null && role.trim().isNotEmpty) 'pekerjaan: ${role.trim()}',
    if (timezone != null && timezone.isNotEmpty) 'zona waktu: $timezone',
    if (currency != null && currency.isNotEmpty) 'mata uang utama: $currency',
  ].join(', ');
  return '''
Kamu adalah asisten di aplikasi Time Pilot, aplikasi pelacak waktu dan tugas untuk freelancer.
Bantu pengguna soal manajemen waktu, menentukan tarif, menagih klien, bekerja lintas zona waktu, dan produktivitas.
${who.isEmpty ? '' : 'Profil pengguna ($who).'}
Jawab dalam Bahasa Indonesia yang ringkas dan praktis.
Tulis teks biasa tanpa format markdown (jangan pakai tanda * atau # ); untuk daftar pakai angka "1." atau tanda "-".
Jika tidak yakin atau tidak tahu, katakan jujur, jangan mengarang fakta.
Untuk pertanyaan hukum, pajak, atau keuangan, beri informasi umum dan sarankan menghubungi ahli.
''';
}

/// Chatbot Gemini lewat REST generateContent (PBI-24). Model dicoba berurutan
/// seperti [CafeLlmService.models].
class ChatService {
  ChatService({http.Client? client}) : _client = client ?? http.Client();

  final http.Client _client;

  Future<String> reply(List<ChatMessage> history, String systemPrompt) async {
    if (Env.geminiApiKey.isEmpty) {
      throw StateError('Fitur chat belum dikonfigurasi (kunci AI kosong).');
    }
    Object? lastError;
    for (final m in CafeLlmService.models) {
      try {
        var res = await _post(history, systemPrompt, m.name, m.timeout, true);
        if (res.statusCode == 400) {
          res = await _post(history, systemPrompt, m.name, m.timeout, false);
        }
        final body = jsonDecode(utf8.decode(res.bodyBytes));
        if (res.statusCode != 200) {
          throw StateError(geminiErrorMessage(body, res.statusCode));
        }
        return extractModelText(body).trim();
      } catch (e) {
        lastError = '${m.name}: ${e is StateError ? e.message : e}';
      }
    }
    throw StateError('$lastError');
  }

  Future<http.Response> _post(
    List<ChatMessage> history,
    String system,
    String model,
    Duration timeout,
    bool lowThinking,
  ) {
    return _client
        .post(
          Uri.https(
            'generativelanguage.googleapis.com',
            '/v1beta/models/$model:generateContent',
          ),
          headers: {
            'Content-Type': 'application/json',
            'x-goog-api-key': Env.geminiApiKey,
          },
          body: jsonEncode(buildChatBody(history, system, lowThinking: lowThinking)),
        )
        .timeout(timeout);
  }
}
</file>

