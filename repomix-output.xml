class TaskListPage extends ConsumerStatefulWidget {
  const TaskListPage({super.key});

  @override
  ConsumerState<TaskListPage> createState() => _TaskListPageState();
}

class _TaskListPageState extends ConsumerState<TaskListPage> {
  final _search = TextEditingController();

  @override
  void dispose() {
    _search.dispose();
    super.dispose();
  }

  Widget _brand(ThemeData theme) {
    return Row(
      children: [
        ClipRRect(
          borderRadius: BorderRadius.circular(AppRadius.r8),
          child: Image.asset('assets/images/logo.png', width: 32, height: 32),
        ),
        const SizedBox(width: AppSpacing.s8),
        Text.rich(
          TextSpan(
            style: theme.textTheme.titleLarge?.copyWith(
              fontWeight: FontWeight.w700,
            ),
            children: const [
              TextSpan(
                text: 'Time',
                style: TextStyle(color: AppColors.navy),
              ),
              TextSpan(
                text: 'Pilot',
                style: TextStyle(color: AppColors.orange),
              ),
            ],
          ),
        ),
      ],
    );
  }

  Widget _dropdown({
    required String label,
    required String? value,
    required List<DropdownMenuItem<String?>> items,
    required ValueChanged<String?> onChanged,
  }) {
    return Expanded(
      child: DropdownButtonFormField<String?>(
        key: ValueKey(value),
        initialValue: value,
        isExpanded: true,
        iconSize: 18,
        style: const TextStyle(
          fontSize: 12,
          color: AppColors.navy,
          fontFamily: 'Poppins',
        ),
        decoration: InputDecoration(
          labelText: label,
          labelStyle: const TextStyle(fontSize: 12),
          floatingLabelStyle: const TextStyle(fontSize: 12),
          isDense: true,
          contentPadding: const EdgeInsets.symmetric(
            horizontal: AppSpacing.s4,
            vertical: AppSpacing.s4,
          ),
        ),
        items: items,
        onChanged: onChanged,
      ),
    );
  }

  Widget _sortButton(bool latestFirst) {
    final active = latestFirst ? AppColors.blue : AppColors.navInactive;
    return PopupMenuButton<bool>(
      tooltip: 'Urutkan berdasarkan waktu',
      position: PopupMenuPosition.under,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(AppRadius.r12),
      ),
      onSelected: ref.read(taskSortLatestFirstProvider.notifier).set,
      itemBuilder: (_) => [
        CheckedPopupMenuItem<bool>(
          value: false,
          checked: !latestFirst,
          child: const Text('Waktu terdekat'),
        ),
        CheckedPopupMenuItem<bool>(
          value: true,
          checked: latestFirst,
          child: const Text('Waktu terlama'),
        ),
      ],
      child: Container(
        width: 44,
        height: 44,
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(AppRadius.r12),
          border: Border.all(
            color: latestFirst ? AppColors.blue : AppColors.surfaceGray,
          ),
        ),
        child: Icon(Icons.swap_vert_rounded, color: active),
      ),
    );
  }

  Widget _filters(
    TaskFilter filter,
    TaskFilterNotifier notifier,
    List<Client> clients,
    bool latestFirst,
  ) {
    return Padding(
      padding: const EdgeInsets.fromLTRB(
        AppSpacing.s16,
        AppSpacing.s12,
        AppSpacing.s16,
        0,
      ),
      child: Column(
        children: [
          TextField(
            controller: _search,
            onChanged: notifier.setQuery,
            textInputAction: TextInputAction.search,
            decoration: InputDecoration(
              hintText: 'Cari tugas atau klien\u2026',
              prefixIcon: const Icon(Icons.search),
              suffixIcon: filter.query.isEmpty
                  ? null
                  : IconButton(
                      icon: const Icon(Icons.clear),
                      onPressed: () {
                        _search.clear();
                        notifier.setQuery('');
                      },
                    ),
            ),
          ),
          const SizedBox(height: AppSpacing.s8),
          Row(
            children: [
              _dropdown(
                label: 'Status',
                value: filter.status,
                onChanged: notifier.setStatus,
                items: const [
                  DropdownMenuItem(value: null, child: Text('Semua')),
                  DropdownMenuItem(
                    value: TaskStatus.todo,
                    child: Text('Belum'),
                  ),
                  DropdownMenuItem(
                    value: TaskStatus.inProgress,
                    child: Text('Berjalan'),
                  ),
                  DropdownMenuItem(
                    value: TaskStatus.done,
                    child: Text('Selesai'),
                  ),
                ],
              ),
              const SizedBox(width: AppSpacing.s8),
              _dropdown(
                label: 'Klien',
                value: filter.clientId,
                onChanged: notifier.setClient,
                items: [
                  const DropdownMenuItem(value: null, child: Text('Semua')),
                  for (final c in clients)
                    DropdownMenuItem(value: c.id, child: Text(c.name)),
                ],
              ),
              const SizedBox(width: AppSpacing.s8),
              _dropdown(
                label: 'Valuta',
                value: filter.currency,
                onChanged: notifier.setCurrency,
                items: [
                  const DropdownMenuItem(value: null, child: Text('Semua')),
                  for (final c in Currencies.all)
                    DropdownMenuItem(value: c, child: Text(c)),
                ],
              ),
              const SizedBox(width: AppSpacing.s8),
              _sortButton(latestFirst),
            ],
          ),
        ],
      ),
    );
  }

  Widget _empty(bool noTasks, TaskFilter filter, TaskFilterNotifier notifier) {
    return Padding(
      padding: const EdgeInsets.all(AppSpacing.s24),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          const Icon(
            Icons.assignment_outlined,
            size: 56,
            color: AppColors.navInactive,
          ),
          const SizedBox(height: AppSpacing.s12),
          Text(
            noTasks
                ? 'Belum ada tugas.\nKetuk tombol + untuk menambahkan.'
                : 'Tidak ada tugas yang cocok.',
            textAlign: TextAlign.center,
          ),
          if (filter.isActive) ...[
            const SizedBox(height: AppSpacing.s12),
            TextButton(
              onPressed: () {
                _search.clear();
                notifier.reset();
              },
              child: const Text('Reset filter'),
            ),
          ],
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final all = ref.watch(tasksProvider);
    final tasks = ref.watch(filteredTasksProvider);
    final clients = ref.watch(clientsProvider);
    final filter = ref.watch(taskFilterProvider);
    final latestFirst = ref.watch(taskSortLatestFirstProvider);
    final home = ref.watch(homeZoneProvider);
    final byId = {for (final c in clients) c.id: c};
    final notifier = ref.read(taskFilterProvider.notifier);

    return Scaffold(
      appBar: AppBar(titleSpacing: AppSpacing.s16, title: _brand(theme)),
      floatingActionButton: FloatingActionButton(
        onPressed: () => Navigator.of(
          context,
        ).push(MaterialPageRoute<void>(builder: (_) => const TaskFormPage())),
        tooltip: 'Tugas baru',
        backgroundColor: AppColors.blue,
        foregroundColor: Colors.white,
        child: const Icon(Icons.add),
      ),
      body: CustomScrollView(
        slivers: [
          const SliverToBoxAdapter(child: _DashboardHeader()),
          SliverToBoxAdapter(
            child: Padding(
              padding: const EdgeInsets.fromLTRB(
                AppSpacing.s16,
                AppSpacing.s24,
                AppSpacing.s16,
                0,
              ),
              child: Row(
                children: [
                  Text('Daftar Tugas', style: theme.textTheme.titleMedium),
                  const SizedBox(width: AppSpacing.s8),
                  Container(
                    padding: const EdgeInsets.symmetric(
                      horizontal: AppSpacing.s8,
                      vertical: 2,
                    ),
                    decoration: BoxDecoration(
                      color: AppColors.blue.withValues(alpha: 0.12),
                      borderRadius: BorderRadius.circular(AppRadius.r12),
                    ),
                    child: Text(
                      '${tasks.length}',
                      style: theme.textTheme.labelMedium?.copyWith(
                        color: AppColors.blue,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
          SliverToBoxAdapter(
            child: _filters(filter, notifier, clients, latestFirst),
          ),
          if (tasks.isEmpty)
            SliverToBoxAdapter(
              child: Center(child: _empty(all.isEmpty, filter, notifier)),
            )
          else
            SliverPadding(
              padding: const EdgeInsets.fromLTRB(
                AppSpacing.s16,
                AppSpacing.s12,
                AppSpacing.s16,
                88,
              ),
              sliver: SliverList.builder(
                itemCount: tasks.length,
                itemBuilder: (context, i) => _TaskCard(
                  task: tasks[i],
                  client: byId[tasks[i].clientId],
                  homeZone: home,
                ),
              ),
            ),
        ],
      ),
    );
  }
}

class _DashboardHeader extends ConsumerWidget {
  const _DashboardHeader();

  String _duration(int seconds) {
    final h = seconds ~/ 3600;
    final m = (seconds % 3600) ~/ 60;
    return h == 0 ? '${m}m' : '${h}j ${m}m';
  }

  void _push(BuildContext context, Widget page) =>
      Navigator.of(context).push(MaterialPageRoute<void>(builder: (_) => page));

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final theme = Theme.of(context);
    final user = ref.watch(authControllerProvider).value;
    final tasks = ref.watch(tasksProvider);
    final earnings = ref.watch(earningsProvider);
    final idrPerUsd = ref.watch(ratesProvider).value?.perUsd['IDR'];

    final name = (user?.fullName ?? user?.username ?? '').trim();
    final done = tasks.where((t) => t.status == TaskStatus.done).length;
    final seconds = earnings.fold<int>(0, (a, e) => a + e.totalSeconds);
    final late = earnings.fold<int>(0, (a, e) => a + e.lateMinutes);

    return Padding(
      padding: const EdgeInsets.all(AppSpacing.s16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            name.isEmpty ? 'Selamat Datang' : 'Selamat Datang, $name',
            style: theme.textTheme.headlineSmall,
          ),
          const SizedBox(height: AppSpacing.s16),
          const CafeEntryCard(),
          const ChatEntryCard(),
          const SizedBox(height: AppSpacing.s16),
          Container(
            padding: const EdgeInsets.all(AppSpacing.s16),
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(AppRadius.r24),
              boxShadow: AppShadows.soft,
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text('Ringkasan Statistik', style: theme.textTheme.titleMedium),
                const SizedBox(height: AppSpacing.s12),
                Row(
                  children: [
                    Expanded(
                      child: _StatTile(
                        icon: Icons.check_rounded,
                        color: AppColors.success,
                        label: 'Tugas Selesai',
                        value: '$done / ${tasks.length}',
                        unit: 'Tugas',
                      ),
                    ),
                    const SizedBox(width: AppSpacing.s12),
                    Expanded(
                      child: _StatTile(
                        icon: Icons.schedule_rounded,
                        color: AppColors.error,
                        label: 'Keterlambatan',
                        value: '$late',
                        unit: 'Menit',
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: AppSpacing.s12),
                Row(
                  children: [
                    Expanded(
                      child: _StatTile(
                        icon: Icons.timer_outlined,
                        color: AppColors.blue,
                        label: 'Waktu Kerja',
                        value: _duration(seconds),
                      ),
                    ),
                    const SizedBox(width: AppSpacing.s12),
                    Expanded(
                      child: _StatTile(
                        icon: Icons.currency_exchange_rounded,
                        color: AppColors.warning,
                        label: 'Kurs 1 USD',
                        value: idrPerUsd == null
                            ? '-'
                            : formatMoney(idrPerUsd, Currencies.idr),
                      ),
                    ),
                  ],
                ),
              ],
            ),
          ),
          const SizedBox(height: AppSpacing.s24),
          Text('Menu Utama', style: theme.textTheme.titleMedium),
          const SizedBox(height: AppSpacing.s12),
          Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Expanded(
                child: _MenuTile(
                  icon: Icons.add_rounded,
                  color: AppColors.blue,
                  title: 'Tambah Tugas',
                  onTap: () => _push(context, const TaskFormPage()),
                ),
              ),
              const SizedBox(width: AppSpacing.s8),
              Expanded(
                child: _MenuTile(
                  icon: Icons.payments_outlined,
                  color: AppColors.success,
                  title: 'Pendapatan',
                  onTap: () => _push(context, const EarningsPage()),
                ),
              ),
              const SizedBox(width: AppSpacing.s8),
              Expanded(
                child: _MenuTile(
                  icon: Icons.person_outline_rounded,
                  color: AppColors.orange,
                  title: 'Atur Persona',
                  onTap: () =>
                      _push(context, const PersonaSetupPage(onboarding: false)),
                ),
              ),
              const SizedBox(width: AppSpacing.s8),
              Expanded(
                child: _MenuTile(
                  icon: Icons.link,
                  color: AppColors.navy,
                  title: 'Blockchain',
                  onTap: () => _push(context, const BlockchainPage()),
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
}

