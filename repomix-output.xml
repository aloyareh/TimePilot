<file path="lib/features/auth/biometric_toggle_tile.dart">
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'biometric_provider.dart';

class BiometricToggleTile extends ConsumerStatefulWidget {
  const BiometricToggleTile({super.key});

  @override
  ConsumerState<BiometricToggleTile> createState() =>
      _BiometricToggleTileState();
}

class _BiometricToggleTileState extends ConsumerState<BiometricToggleTile> {
  bool _busy = false;

  Future<void> _toggle(bool value) async {
    setState(() => _busy = true);
    final ctrl = ref.read(biometricEnabledProvider.notifier);
    if (value) {
      final ok = await ctrl.enable();
      if (!ok && mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text(
              'Biometrik tidak tersedia, belum didaftarkan di HP, atau dibatalkan.',
            ),
          ),
        );
      }
    } else {
      await ctrl.disable();
    }
    if (mounted) setState(() => _busy = false);
  }

  @override
  Widget build(BuildContext context) {
    final enabled = ref.watch(biometricEnabledProvider);
    return SwitchListTile(
      secondary: const Icon(Icons.fingerprint),
      title: const Text('Biometrik'),
      subtitle: const Text(
        'Aktifkan untuk Login dan buka halaman Pendapatan dengan biometrik',
      ),
      value: enabled.value ?? false,
      onChanged: (enabled.isLoading || _busy) ? null : _toggle,
    );
  }
}
</file>

<file path="lib/features/blockchain/chain_repository.dart">
import 'dart:convert';

import 'package:flutter/foundation.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:hive_ce_flutter/hive_flutter.dart';

import '../../data/local/models/work_session.dart';
import '../profile/profile_providers.dart';
import '../session/session_money.dart';
import 'chain.dart';

/// Penyimpanan rantai di Hive (box 'chain'), satu entri JSON per blok.
class ChainRepository {
  ChainRepository(this.userId);

  /// Satu rantai per akun: kotak Hive dinamai dari ID pengguna.
  final String userId;

  String get _boxName => 'chain_${userId.replaceAll('-', '_')}';

  Future<Box<String>> _box() async => Hive.isBoxOpen(_boxName)
      ? Hive.box<String>(_boxName)
      : await Hive.openBox<String>(_boxName);

  Future<List<Block>> all() async {
    final box = await _box();
    final out = <Block>[];
    for (final raw in box.values) {
      try {
        out.add(Block.fromJson(jsonDecode(raw) as Map<String, dynamic>));
      } catch (_) {
        // Entri rusak dilewati; celah nomor urut akan terdeteksi saat verifikasi.
      }
    }
    out.sort((a, b) => a.index.compareTo(b.index));
    return out;
  }

  Future<void> put(Block b) async {
    final box = await _box();
    await box.put(b.index.toString().padLeft(8, '0'), jsonEncode(b.toJson()));
  }
}

/// null = belum login (tidak ada rantai).
final chainRepositoryProvider = Provider<ChainRepository?>((ref) {
  final uid = ref.watch(currentUserIdProvider);
  return uid == null ? null : ChainRepository(uid);
});

class ChainNotifier extends AsyncNotifier<List<Block>> {
  @override
  Future<List<Block>> build() async {
    final repo = ref.watch(chainRepositoryProvider);
    return repo == null ? const <Block>[] : repo.all();
  }

  /// Menambah blok untuk sesi yang selesai. Idempotent: sesi yang sama tidak
  /// dicatat dua kali.
  Future<Block> addForSession(WorkSession s, SessionMoney money) async {
    final repo = ref.read(chainRepositoryProvider);
    if (repo == null) throw StateError('Belum login.');
    await future; // pastikan build() awal selesai agar tidak menimpa state kita
    final blocks = await repo.all();
    for (final b in blocks) {
      if (b.sessionId == s.id) return b;
    }
    final block = Block.create(
      prev: blocks.isEmpty ? null : blocks.last,
      endedAtUtc: s.endedAtUtc ?? DateTime.now().toUtc(),
      sessionId: s.id,
      taskId: s.taskId,
      clientId: s.clientId,
      durationSeconds: s.durationSeconds,
      lateMinutes: s.lateMinutes,
      currency: money.currency,
      netMinor: money.netMinor,
    );
    await repo.put(block);
    state = AsyncData([...blocks, block]);
    return block;
  }

  Future<void> reload() async {
    final repo = ref.read(chainRepositoryProvider);
    state = AsyncData(repo == null ? const <Block>[] : await repo.all());
  }
}

final chainProvider = AsyncNotifierProvider<ChainNotifier, List<Block>>(
  ChainNotifier.new,
);

void logChainError(Object e) => debugPrint('Blockchain: gagal mencatat blok: $e');
</file>

<file path="lib/features/cafes/nearby_places_service.dart">
import 'dart:convert';
import 'dart:math';

import 'package:http/http.dart' as http;

import 'cafe_llm_service.dart';

/// Tempat kerja nyata di sekitar koordinat, dari OpenStreetMap lewat Overpass API
/// (gratis, tanpa kunci). Data bergantung pada kontribusi pengguna OSM, jadi
/// kafe yang belum dipetakan tidak muncul dan jam buka bisa kedaluwarsa.
class NearbyPlacesService {
  NearbyPlacesService({http.Client? client}) : _client = client ?? http.Client();

  final http.Client _client;

  static const _endpoints = [
    'https://overpass-api.de/api/interpreter',
    'https://overpass.kumi.systems/api/interpreter',
  ];

  static String buildQuery(double lat, double lon, int radiusMeters) => '''
[out:json][timeout:10];
(
  nwr["amenity"="cafe"]["name"](around:$radiusMeters,$lat,$lon);
  nwr["amenity"="coworking_space"]["name"](around:$radiusMeters,$lat,$lon);
  nwr["office"="coworking"]["name"](around:$radiusMeters,$lat,$lon);
);
out center 60;
''';

  Future<List<Cafe>> search({
    required double latitude,
    required double longitude,
    int radiusMeters = 1500,
    int limit = 8,
  }) async {
    final errors = <String>[];
    for (final url in _endpoints) {
      final host = Uri.parse(url).host;
      try {
        final res = await _client
            .post(
              Uri.parse(url),
              headers: {
                'User-Agent': 'TimePilot/0.1 (student project)',
                'Accept': 'application/json',
              },
              body: {'data': buildQuery(latitude, longitude, radiusMeters)},
            )
            .timeout(const Duration(seconds: 12));
        if (res.statusCode != 200) {
          errors.add('$host: HTTP ${res.statusCode}');
          continue;
        }
        return parsePlaces(
          jsonDecode(utf8.decode(res.bodyBytes)),
          latitude,
          longitude,
          limit: limit,
        );
      } catch (e) {
        errors.add('$host: ${e.runtimeType}');
      }
    }

    // Overpass publik sering penuh. Cadangan: Nominatim (juga data OSM, lebih ringan).
    try {
      return await _searchNominatim(latitude, longitude, radiusMeters, limit);
    } catch (e) {
      errors.add('nominatim: ${e is StateError ? e.message : e.runtimeType}');
    }
    throw StateError('Server peta tidak menjawab (${errors.join('; ')}).');
  }

  Future<List<Cafe>> _searchNominatim(
    double lat,
    double lon,
    int radiusMeters,
    int limit,
  ) async {
    final dLat = radiusMeters / 111320;
    final dLon = radiusMeters / (111320 * cos(lat * pi / 180));
    final viewbox = '${lon - dLon},${lat + dLat},${lon + dLon},${lat - dLat}';
    final all = <dynamic>[];
    for (final q in const ['cafe', 'coworking space']) {
      final res = await _client
          .get(
            Uri.https('nominatim.openstreetmap.org', '/search', {
              'q': q,
              'format': 'jsonv2',
              'viewbox': viewbox,
              'bounded': '1',
              'limit': '30',
              'extratags': '1',
              'namedetails': '1',
              'addressdetails': '1',
            }),
            headers: {
              'User-Agent': 'TimePilot/0.1 (student project)',
              'Accept': 'application/json',
            },
          )
          .timeout(const Duration(seconds: 12));
      if (res.statusCode != 200) {
        throw StateError('HTTP ${res.statusCode}');
      }
      final body = jsonDecode(utf8.decode(res.bodyBytes));
      if (body is List) all.addAll(body);
    }
    return parseNominatim(all, lat, lon, limit: limit);
  }
}

double distanceMeters(double lat1, double lon1, double lat2, double lon2) {
  const r = 6371000.0;
  double rad(double d) => d * pi / 180;
  final dLat = rad(lat2 - lat1);
  final dLon = rad(lon2 - lon1);
  final a =
      pow(sin(dLat / 2), 2) +
      cos(rad(lat1)) * cos(rad(lat2)) * pow(sin(dLon / 2), 2);
  return 2 * r * asin(sqrt(a));
}

String formatDistance(double m) =>
    m < 1000 ? '${m.round()} m' : '${(m / 1000).toStringAsFixed(1)} km';

/// Mengubah respons Overpass menjadi daftar tempat, terdekat dulu. Fungsi murni.
List<Cafe> parsePlaces(
  dynamic json,
  double userLat,
  double userLon, {
  int limit = 8,
}) {
  final elements = json is Map ? json['elements'] : null;
  if (elements is! List) {
    throw const FormatException('Respons peta tidak sesuai.');
  }
  final found = <({Cafe cafe, double dist})>[];
  final seen = <String>{};
  for (final e in elements) {
    if (e is! Map) continue;
    final tags = e['tags'];
    if (tags is! Map) continue;
    final name = (tags['name'] ?? '').toString().trim();
    if (name.isEmpty) continue;
    final center = e['center'];
    final lat = ((e['lat'] ?? (center is Map ? center['lat'] : null)) as num?)
        ?.toDouble();
    final lon = ((e['lon'] ?? (center is Map ? center['lon'] : null)) as num?)
        ?.toDouble();
    if (lat == null || lon == null) continue;
    // Satu tempat bisa muncul sebagai node dan way sekaligus.
    if (!seen.add('${name.toLowerCase()}|${lat.toStringAsFixed(3)}|${lon.toStringAsFixed(3)}')) {
      continue;
    }

    final cowork =
        tags['amenity'] == 'coworking_space' || tags['office'] == 'coworking';
    final dist = distanceMeters(userLat, userLon, lat, lon);
    final street = (tags['addr:street'] ?? '').toString().trim();
    final wifi = (tags['internet_access'] ?? '').toString();
    final hours = (tags['opening_hours'] ?? '').toString().trim();
    final notes = <String>[
      if (wifi == 'wlan' || wifi == 'yes') 'WiFi tersedia',
      if (hours.isNotEmpty) 'Jam buka: $hours',
    ];
    found.add((
      dist: dist,
      cafe: Cafe(
        name: name,
        type: cowork ? 'Coworking' : 'Kafe',
        area: [formatDistance(dist), if (street.isNotEmpty) street].join(' • '),
        note: notes.join(' · '),
        latitude: lat,
        longitude: lon,
      ),
    ));
  }
  found.sort((a, b) => a.dist.compareTo(b.dist));
  return found.take(limit).map((f) => f.cafe).toList();
}

/// Mengubah hasil Nominatim (jsonv2 + extratags + addressdetails) menjadi daftar
/// tempat, terdekat dulu. Fungsi murni.
List<Cafe> parseNominatim(
  List<dynamic> items,
  double userLat,
  double userLon, {
  int limit = 8,
}) {
  final found = <({Cafe cafe, double dist})>[];
  final seen = <String>{};
  for (final e in items) {
    if (e is! Map) continue;
    final name = (e['name'] ?? '').toString().trim();
    final lat = double.tryParse('${e['lat']}');
    final lon = double.tryParse('${e['lon']}');
    if (name.isEmpty || lat == null || lon == null) continue;
    if (!seen.add('${name.toLowerCase()}|${lat.toStringAsFixed(3)}|${lon.toStringAsFixed(3)}')) {
      continue;
    }
    final type = (e['type'] ?? '').toString();
    final cowork = type.contains('cowork') || name.toLowerCase().contains('cowork');
    final isCafe = type == 'cafe' || type == 'coffee_shop';
    if (!cowork && !isCafe) continue;
    final extra = e['extratags'] is Map ? e['extratags'] as Map : const {};
    final addr = e['address'] is Map ? e['address'] as Map : const {};
    final street = (addr['road'] ?? '').toString().trim();
    final wifi = (extra['internet_access'] ?? '').toString();
    final hours = (extra['opening_hours'] ?? '').toString().trim();
    final dist = distanceMeters(userLat, userLon, lat, lon);
    found.add((
      dist: dist,
      cafe: Cafe(
        name: name,
        type: cowork ? 'Coworking' : 'Kafe',
        area: [formatDistance(dist), if (street.isNotEmpty) street].join(' • '),
        note: [
          if (wifi == 'wlan' || wifi == 'yes') 'WiFi tersedia',
          if (hours.isNotEmpty) 'Jam buka: $hours',
        ].join(' · '),
        latitude: lat,
        longitude: lon,
      ),
    ));
  }
  found.sort((a, b) => a.dist.compareTo(b.dist));
  return found.take(limit).map((f) => f.cafe).toList();
}
</file>

<file path="lib/features/challenges/shake_challenge_page.dart">
import 'dart:async';

import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:sensors_plus/sensors_plus.dart';

import '../../core/theme/app_theme.dart';
import 'shake_counter.dart';

class ShakeChallengePage extends StatefulWidget {
  const ShakeChallengePage({super.key, this.difficulty = 1});

  final int difficulty;

  @override
  State<ShakeChallengePage> createState() => _ShakeChallengePageState();
}

class _ShakeChallengePageState extends State<ShakeChallengePage> {
  late final ShakeCounter _counter = ShakeCounter(
    target: ShakeCounter.randomTarget(),
  );
  final _count = ValueNotifier<int>(0);
  StreamSubscription<UserAccelerometerEvent>? _sub;
  bool _finished = false;
  String? _sensorError;

  @override
  void initState() {
    super.initState();
    _sub =
        userAccelerometerEventStream(
          samplingPeriod: SensorInterval.gameInterval,
        ).listen(
          (e) => _onSample(e.x, e.y, e.z),
          onError: (Object _) {
            if (mounted) {
              setState(
                () => _sensorError =
                    'Sensor gerak tidak tersedia di perangkat ini.',
              );
            }
          },
          cancelOnError: false,
        );
  }

  void _onSample(double x, double y, double z) {
    if (_finished) return;
    final counted = _counter.addSample(
      x: x,
      y: y,
      z: z,
      timestampMs: DateTime.now().millisecondsSinceEpoch,
    );
    if (!counted) return;
    HapticFeedback.lightImpact();
    _count.value = _counter.count;
    if (_counter.isDone) _complete();
  }

  Future<void> _complete() async {
    _finished = true;
    await _sub?.cancel();
    _sub = null;
    HapticFeedback.heavyImpact();
    await Future<void>.delayed(const Duration(milliseconds: 600));
    if (!mounted) return;
    Navigator.of(context).pop(true);
  }

  @override
  void dispose() {
    _sub?.cancel();
    _count.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final target = _counter.target;

    return Scaffold(
      appBar: AppBar(title: const Text('Shake to Wake')),
      body: SafeArea(
        child: Padding(
          padding: const EdgeInsets.all(AppSpacing.s24),
          child: ValueListenableBuilder<int>(
            valueListenable: _count,
            builder: (context, count, _) {
              final done = count >= target;
              final accent = done ? AppColors.success : AppColors.orange;
              return Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Container(
                    width: 144,
                    height: 144,
                    decoration: BoxDecoration(
                      color: Colors.white,
                      shape: BoxShape.circle,
                      boxShadow: AppShadows.medium,
                    ),
                    child: Icon(
                      done ? Icons.check_circle : Icons.vibration,
                      size: 80,
                      color: accent,
                    ),
                  ),
                  const SizedBox(height: AppSpacing.s24),
                  Text(
                    done ? 'Alarm dimatikan!' : 'Kocok HP-mu!',
                    style: theme.textTheme.headlineSmall,
                  ),
                  const SizedBox(height: AppSpacing.s8),
                  Text(
                    'Kocok $target kali untuk mematikan alarm.',
                    textAlign: TextAlign.center,
                    style: theme.textTheme.bodySmall,
                  ),
                  const SizedBox(height: AppSpacing.s32),
                  Container(
                    width: double.infinity,
                    padding: const EdgeInsets.all(AppSpacing.s16),
                    decoration: BoxDecoration(
                      color: Colors.white,
                      borderRadius: BorderRadius.circular(AppRadius.r24),
                      boxShadow: AppShadows.soft,
                    ),
                    child: Column(
                      children: [
                        Text(
                          '$count / $target',
                          style: theme.textTheme.displayMedium?.copyWith(
                            fontWeight: FontWeight.w700,
                            fontFeatures: const [FontFeature.tabularFigures()],
                          ),
                        ),
                        const SizedBox(height: AppSpacing.s16),
                        ClipRRect(
                          borderRadius: BorderRadius.circular(AppRadius.r8),
                          child: LinearProgressIndicator(
                            value: count / target,
                            minHeight: 12,
                            color: done ? AppColors.success : AppColors.blue,
                            backgroundColor: AppColors.surfaceGray,
                          ),
                        ),
                      ],
                    ),
                  ),
                  if (_sensorError != null) ...[
                    const SizedBox(height: AppSpacing.s24),
                    Text(
                      _sensorError!,
                      style: const TextStyle(
                        color: AppColors.error,
                        fontSize: 13,
                      ),
                      textAlign: TextAlign.center,
                    ),
                  ],
                  if (kDebugMode && !done) ...[
                    const SizedBox(height: AppSpacing.s24),
                    TextButton(
                      onPressed: () {
                        _counter.addSample(
                          x: 99,
                          y: 0,
                          z: 0,
                          timestampMs:
                              DateTime.now().millisecondsSinceEpoch +
                              1000000 * count,
                        );
                        _count.value = _counter.count;
                        if (_counter.isDone) _complete();
                      },
                      child: const Text('Simulasi 1 kocokan (debug)'),
                    ),
                  ],
                ],
              );
            },
          ),
        ),
      ),
    );
  }
}
</file>

