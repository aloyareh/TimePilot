<file path="lib/data/remote/session_storage.dart">
import 'dart:convert';

import 'package:flutter_secure_storage/flutter_secure_storage.dart';

import '../models/app_user.dart';

class SessionStorage {
  const SessionStorage([this._storage = const FlutterSecureStorage()]);

  final FlutterSecureStorage _storage;
  static const _tokenKey = 'session_token';
  static const _userKey = 'session_user';
  static const _bioKey = 'biometric_enabled';

  Future<bool> readBiometricEnabled() async =>
      (await _storage.read(key: _bioKey)) == 'true';

  Future<void> saveBiometricEnabled(bool value) =>
      _storage.write(key: _bioKey, value: value.toString());

  Future<String?> readToken() => _storage.read(key: _tokenKey);

  Future<AppUser?> readUser() async {
    final raw = await _storage.read(key: _userKey);
    if (raw == null) return null;
    return AppUser.fromJson(jsonDecode(raw) as Map<String, dynamic>);
  }

  Future<void> save(String token, AppUser user) async {
    await _storage.write(key: _tokenKey, value: token);
    await _storage.write(key: _userKey, value: jsonEncode(user.toJson()));
  }

  Future<void> clear() async {
    await _storage.delete(key: _tokenKey);
    await _storage.delete(key: _userKey);
    await _storage.delete(key: _bioKey);
  }
}
</file>

<file path="lib/data/repositories/client_repository.dart">
import 'package:hive_ce_flutter/hive_flutter.dart';

import '../local/hive_boxes.dart';
import '../local/models/client.dart';

class ClientRepository {
  Box<Client> get _box => Hive.box<Client>(HiveBoxes.clients);

  Future<void> save(Client client) => _box.put(client.id, client);

  Client? getById(String id) {
    final client = _box.get(id);
    if (client == null || client.isDeleted) return null;
    return client;
  }

  /// Hanya klien milik [ownerId] yang belum dihapus.
  List<Client> getAll(String ownerId) =>
      _box.values.where((c) => !c.isDeleted && c.ownerId == ownerId).toList();

  Future<void> delete(String id) async {
    final c = _box.get(id);
    if (c == null) return;
    await _box.put(
      id,
      Client(
        id: c.id,
        name: c.name,
        timezoneId: c.timezoneId,
        hourlyRate: c.hourlyRate,
        currency: c.currency,
        updatedAt: DateTime.now().toUtc(),
        isDeleted: true,
        ownerId: c.ownerId,
      ),
    );
  }
}
</file>

