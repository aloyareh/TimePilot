<file path="lib/features/challenges/balance_challenge_page.dart">
import 'dart:async';
import 'dart:math';

import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:sensors_plus/sensors_plus.dart';

import '../../core/theme/app_theme.dart';
import 'balance_tracker.dart';

/// Tantangan "Balance Challenge" (PBI-15, US-2).
///
/// Miringkan HP sampai bola masuk ke lingkaran target (posisinya acak tiap ronde),
/// lalu tahan 3 detik berturut-turut, sebanyak 4 ronde. HP yang diam rata di meja
/// tidak lolos karena target selalu miring. Setelah ronde terakhir, halaman
/// memanggil `pop(true)` (kontrak challenge_registry.dart) sehingga alarm
/// dimatikan dan tombol Start Work Session aktif.
///
/// Sensor dibaca lewat Stream; UI hanya di-update ~30 fps lewat ValueNotifier,
/// jadi thread UI tidak terbebani.
class BalanceChallengePage extends StatefulWidget {
  const BalanceChallengePage({super.key, this.difficulty = 1});

  /// Diterima dari kontrak registry; aturan tetap (3 dtk x 4 ronde, target acak).
  final int difficulty;

  @override
  State<BalanceChallengePage> createState() => _BalanceChallengePageState();
}

class _BalanceChallengePageState extends State<BalanceChallengePage> {
  static const _maxAngle = 36 * pi / 180; // simpangan di tepi lingkaran luar
  static const _uiIntervalMs = 33;

  final _tracker = BalanceTracker();
  final _view = ValueNotifier<_BalanceView>(const _BalanceView.initial());
  StreamSubscription<AccelerometerEvent>? _accSub;
  StreamSubscription<GyroscopeEvent>? _gyroSub;
  int _lastUiMs = 0;
  bool _finished = false;
  String? _sensorError;

  @override
  void initState() {
    super.initState();
    _accSub = accelerometerEventStream(
      samplingPeriod: SensorInterval.gameInterval,
    ).listen((e) => _tracker.updateAccel(e.x, e.y, e.z), onError: _onError);
    _gyroSub = gyroscopeEventStream(samplingPeriod: SensorInterval.gameInterval)
        .listen(_onGyro, onError: _onError);
  }

  void _onError(Object e) {
    debugPrint('Balance sensor error: $e');
    if (mounted) {
      setState(
        () => _sensorError =
            'Sensor gyroscope/accelerometer tidak tersedia di perangkat ini.',
      );
    }
  }

  void _onGyro(GyroscopeEvent e) {
    if (_finished) return;
    final now = DateTime.now().millisecondsSinceEpoch;
    final roundDone = _tracker.updateGyro(e.x, e.y, now);
    if (roundDone) HapticFeedback.mediumImpact();
    if (roundDone || now - _lastUiMs >= _uiIntervalMs) {
      _lastUiMs = now;
      _publish();
    }
    if (_tracker.isDone) _complete();
  }

  void _publish() {
    _view.value = _BalanceView(
      x: (_tracker.roll / _maxAngle).clamp(-1.0, 1.0),
      y: (_tracker.pitch / _maxAngle).clamp(-1.0, 1.0),
      tx: _tracker.targetRoll / _maxAngle,
      ty: _tracker.targetPitch / _maxAngle,
      balanced: _tracker.isBalanced,
      heldMs: _tracker.heldMs,
      rounds: _tracker.completedRounds,
    );
  }

  Future<void> _complete() async {
    if (_finished) return;
    _finished = true;
    await _accSub?.cancel();
    await _gyroSub?.cancel();
    _accSub = _gyroSub = null;
    HapticFeedback.heavyImpact();
    await Future<void>.delayed(const Duration(milliseconds: 600));
    if (!mounted) return;
    Navigator.of(context).pop(true);
  }

  @override
  void dispose() {
    _accSub?.cancel();
    _gyroSub?.cancel();
    _view.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final holdSeconds = _tracker.holdMs / 1000;

    return Scaffold(
      appBar: AppBar(title: const Text('Balance Challenge')),
      body: SafeArea(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: ValueListenableBuilder<_BalanceView>(
            valueListenable: _view,
            builder: (context, v, _) {
              final done = v.rounds >= _tracker.rounds;
              final heldSec = v.heldMs / 1000;
              final round = done ? _tracker.rounds : v.rounds + 1;
              return Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Text(
                    done ? 'Alarm dimatikan!' : 'Seimbangkan HP-mu!',
                    style: theme.textTheme.headlineSmall?.copyWith(
                      fontWeight: FontWeight.w600,
                    ),
                  ),
                  const SizedBox(height: 8),
                  Text(
                    'Miringkan HP sampai bola masuk lingkaran target, lalu tahan '
                    '${holdSeconds.toStringAsFixed(0)} detik. '
                    'Posisi target berubah tiap ronde (${_tracker.rounds} ronde).',
                    textAlign: TextAlign.center,
                  ),
                  const SizedBox(height: 16),
                  Expanded(
                    child: Center(
                      child: AspectRatio(
                        aspectRatio: 1,
                        child: CustomPaint(
                          painter: _BalancePainter(
                            x: v.x,
                            y: v.y,
                            tx: v.tx,
                            ty: v.ty,
                            balanced: v.balanced,
                            targetFraction: _tracker.tolerance / _maxAngle,
                          ),
                        ),
                      ),
                    ),
                  ),
                  const SizedBox(height: 16),
                  const SizedBox(height: 24),
                  Text(
                    'Ronde $round / ${_tracker.rounds}',
                    style: theme.textTheme.titleLarge?.copyWith(
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                  const SizedBox(height: 8),
                  ClipRRect(
                    borderRadius: BorderRadius.circular(8),
                    child: LinearProgressIndicator(
                      value: done ? 1 : (heldSec / holdSeconds).clamp(0.0, 1.0),
                      minHeight: 12,
                      color: v.balanced ? AppColors.success : AppColors.orange,
                      backgroundColor: AppColors.surfaceGray,
                    ),
                  ),
                  const SizedBox(height: 8),
                  Text(
                    done
                        ? 'Selesai'
                        : '${heldSec.toStringAsFixed(1)} / '
                              '${holdSeconds.toStringAsFixed(0)} dtk',
                  ),
                  if (_sensorError != null) ...[
                    const SizedBox(height: 16),
                    Text(
                      _sensorError!,
                      style: TextStyle(color: theme.colorScheme.error),
                      textAlign: TextAlign.center,
                    ),
                  ],
                  // Emulator tanpa sensor: tombol ini hanya ada di debug.
                  if (kDebugMode && !done) ...[
                    const SizedBox(height: 8),
                    TextButton(
                      onPressed: () {
                        _tracker.debugCompleteRound();
                        _publish();
                        if (_tracker.isDone) _complete();
                      },
                      child: const Text('Simulasi 1 ronde (debug)'),
                    ),
                  ],
                ],
              );
            },
          ),
        ),
      ),
    );
  }
}

class _BalanceView {
  const _BalanceView({
    required this.x,
    required this.y,
    required this.tx,
    required this.ty,
    required this.balanced,
    required this.heldMs,
    required this.rounds,
  });

  const _BalanceView.initial()
    : x = 0,
      y = 0,
      tx = 0,
      ty = 0,
      balanced = true,
      heldMs = 0,
      rounds = 0;

  /// Posisi bola ternormalisasi -1..1 (kanan/bawah positif).
  final double x;
  final double y;

  /// Posisi pusat lingkaran target, ternormalisasi seperti [x] dan [y].
  final double tx;
  final double ty;
  final bool balanced;
  final int heldMs;
  final int rounds;
}

class _BalancePainter extends CustomPainter {
  _BalancePainter({
    required this.x,
    required this.y,
    required this.tx,
    required this.ty,
    required this.balanced,
    required this.targetFraction,
  });

  final double x;
  final double y;
  final double tx;
  final double ty;
  final bool balanced;
  final double targetFraction;

  @override
  void paint(Canvas canvas, Size size) {
    final center = size.center(Offset.zero);
    final radius = size.shortestSide / 2;
    final ballRadius = radius * 0.1;
    final travel = radius - ballRadius;

    // Lingkaran luar (area gerak bola).
    canvas.drawCircle(center, radius, Paint()..color = AppColors.surfaceGray);
    // Lingkaran target di posisi acak ronde ini.
    final targetColor = balanced ? AppColors.success : AppColors.orange;
    final targetR = radius * targetFraction;
    final targetCenter = center + Offset(tx, ty) * travel;
    canvas.drawCircle(
      targetCenter,
      targetR,
      Paint()..color = targetColor.withAlpha(64),
    );
    canvas.drawCircle(
      targetCenter,
      targetR,
      Paint()
        ..color = targetColor
        ..style = PaintingStyle.stroke
        ..strokeWidth = 3,
    );

    // Bola dibatasi di dalam lingkaran luar.
    var offset = Offset(x, y) * travel;
    if (offset.distance > travel) {
      offset = offset / offset.distance * travel;
    }
    canvas.drawCircle(
      center + offset,
      ballRadius,
      Paint()..color = balanced ? AppColors.success : AppColors.navy,
    );
  }

  @override
  bool shouldRepaint(_BalancePainter old) =>
      old.x != x ||
      old.y != y ||
      old.tx != tx ||
      old.ty != ty ||
      old.balanced != balanced ||
      old.targetFraction != targetFraction;
}
</file>

<file path="lib/features/session/session_providers.dart">
import 'dart:async';

import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:uuid/uuid.dart';

import '../../core/notifications/notification_service.dart';
import '../../data/local/models/task.dart';
import '../../data/local/models/work_session.dart';
import '../../data/repositories/work_session_repository.dart';
import '../blockchain/chain_repository.dart';
import '../profile/profile_providers.dart';
import '../sync/sync_service.dart';
import '../tasks/task_providers.dart';
import 'session_money.dart';

final workSessionRepositoryProvider = Provider<WorkSessionRepository>(
  (ref) => WorkSessionRepository(),
);

/// Menit terlambat = selisih (dibulatkan ke bawah) antara mulai sesi dan jadwal.
/// Mulai sebelum/tepat jadwal = 0.
int computeLateMinutes({
  required DateTime startedUtc,
  required DateTime scheduledUtc,
}) {
  if (!startedUtc.isAfter(scheduledUtc)) return 0;
  return startedUtc.difference(scheduledUtc).inMinutes;
}

/// "01:05:09". Durasi negatif dianggap nol.
String formatHms(Duration d) {
  final x = d.isNegative ? Duration.zero : d;
  String two(int v) => v.toString().padLeft(2, '0');
  return '${two(x.inHours)}:${two(x.inMinutes.remainder(60))}:${two(x.inSeconds.remainder(60))}';
}

/// Sesi kerja yang sedang berjalan (null jika tidak ada). Disimpan di Hive dengan
/// endedAtUtc == null sehingga tetap berjalan walau app ditutup.
class SessionNotifier extends Notifier<WorkSession?> {
  WorkSessionRepository get _repo => ref.read(workSessionRepositoryProvider);

  /// Sesi yang berjalan hanya dicari milik pengguna yang sedang login:
  /// WorkSession belum punya ownerId, jadi kepemilikan diturunkan dari tugasnya.
  /// Memantau currentUserIdProvider agar state ikut berganti saat akun berganti.
  @override
  WorkSession? build() {
    final uid = ref.watch(currentUserIdProvider);
    if (uid == null) return null;
    final tasks = ref.read(taskRepositoryProvider);
    for (final s in _repo.getAll()) {
      if (s.endedAtUtc != null) continue;
      if (tasks.getById(s.taskId)?.ownerId == uid) return s;
    }
    return null;
  }

  Future<WorkSession> start(Task task) async {
    if (state != null) throw StateError('Masih ada sesi yang berjalan.');
    final now = DateTime.now().toUtc();
    final session = WorkSession(
      id: const Uuid().v4(),
      taskId: task.id,
      clientId: task.clientId,
      startedAtUtc: now,
      lateMinutes: computeLateMinutes(
        startedUtc: now,
        scheduledUtc: task.deadlineUtc,
      ),
      updatedAt: now,
    );
    await _repo.save(session);
    await ref.read(tasksProvider.notifier).setStatus(task, TaskStatus.inProgress);
    state = session;
    return session;
  }

  /// Mengakhiri sesi, menyimpan durasi, dan (default) menandai tugas selesai.
  Future<WorkSession> stop({bool markDone = true}) async {
    final s = state;
    if (s == null) throw StateError('Tidak ada sesi yang berjalan.');
    final now = DateTime.now().toUtc();
    final finished = WorkSession(
      id: s.id,
      taskId: s.taskId,
      clientId: s.clientId,
      startedAtUtc: s.startedAtUtc,
      endedAtUtc: now,
      durationSeconds: now.difference(s.startedAtUtc).inSeconds,
      lateMinutes: s.lateMinutes,
      updatedAt: now,
    );
    await _repo.save(finished);
    state = null;
    // Catat ke blockchain (PBI-21). Kegagalan di sini tidak boleh membatalkan sesi.
    try {
      final client = ref.read(clientRepositoryProvider).getById(s.clientId);
      final money = computeSessionMoney(
        durationSeconds: finished.durationSeconds,
        lateMinutes: finished.lateMinutes,
        hourlyRate: client?.hourlyRate ?? 0,
        currency: client?.currency ?? 'IDR',
      );
      await ref.read(chainProvider.notifier).addForSession(finished, money);
    } catch (e) {
      logChainError(e);
    }
    ref.read(challengeClearedProvider.notifier).reset(s.taskId);
    if (markDone) {
      final task = ref.read(taskRepositoryProvider).getById(s.taskId);
      if (task != null) {
        await ref.read(tasksProvider.notifier).setStatus(task, TaskStatus.done);
      }
    }
    // Kirim ke server di latar belakang (best-effort, gagal tidak memengaruhi sesi).
    unawaited(ref.read(syncProvider.notifier).sync());
    return finished;
  }
}

final sessionProvider = NotifierProvider<SessionNotifier, WorkSession?>(
  SessionNotifier.new,
);

/// Tugas yang tantangannya sudah selesai (membuka tombol Start). Disimpan di memori.
class ChallengeClearedNotifier extends Notifier<Set<String>> {
  @override
  Set<String> build() => <String>{};

  /// Dipanggil saat tantangan sukses: membuka Start dan mematikan alarm yang berbunyi.
  Future<void> clear(String taskId) async {
    state = {...state, taskId};
    try {
      final svc = ref.read(notificationServiceProvider);
      await svc.init();
      await svc.cancel(taskAlarmId(taskId));
    } catch (_) {}
  }

  void reset(String taskId) => state = {...state}..remove(taskId);
}

final challengeClearedProvider =
    NotifierProvider<ChallengeClearedNotifier, Set<String>>(
      ChallengeClearedNotifier.new,
    );
</file>

<file path="android/app/src/main/kotlin/com/example/time_pilot/MainActivity.kt">
package com.example.time_pilot

import android.app.KeyguardManager
import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import android.content.IntentFilter
import android.os.Build
import android.os.Bundle
import io.flutter.embedding.android.FlutterFragmentActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel
import android.content.ContentValues
import android.media.AudioAttributes
import android.media.Ringtone
import android.media.RingtoneManager
import android.net.Uri
import android.os.Environment
import android.os.Handler
import android.os.Looper
import android.provider.MediaStore
import android.provider.OpenableColumns
import androidx.activity.result.contract.ActivityResultContracts

/**
 * Manifest memberi showWhenLocked/turnScreenOn supaya alarm bisa menyalakan layar
 * dan tampil di atas layar kunci. Agar app tidak "menempel" di atas layar kunci
 * pada pemakaian biasa:
 *  - alarmMode = true bila aktivitas dibuka saat HP terkunci (alarm).
 *  - Saat layar mati di luar alarmMode, flag showWhenLocked/turnScreenOn dimatikan
 *    sementara: layar kunci muncul normal dan setelah dibuka kunci pengguna kembali
 *    ke app yang tadi terbuka. Flag dinyalakan lagi saat alarm datang (onNewIntent).
 *  - Setelah tantangan alarm selesai, Dart memanggil "leave": minta buka kunci;
 *    bila dibatalkan, task disembunyikan di belakang layar kunci.
 */
class MainActivity : FlutterFragmentActivity() {
    private var alarmMode = false

    private var pendingPick: MethodChannel.Result? = null
    private var preview: Ringtone? = null
    private val previewHandler = Handler(Looper.getMainLooper())
 
    private val pickAudio =
        registerForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
            val res = pendingPick
            pendingPick = null
            if (res == null) return@registerForActivityResult
            if (uri == null) {
                res.success(null)
                return@registerForActivityResult
            }
            Thread {
                try {
                    val out = importToMediaStore(uri)
                    runOnUiThread { res.success(out) }
                } catch (e: Exception) {
                    runOnUiThread { res.error("IMPORT_FAILED", e.message ?: "Gagal mengimpor suara.", null) }
                }
            }.start()
        }
 
    private fun importToMediaStore(src: Uri): Map<String, String> {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) {
            throw IllegalStateException("Impor suara butuh Android 10 atau lebih baru.")
        }
        val cr = contentResolver
        val mime = cr.getType(src) ?: "audio/mpeg"
        if (!mime.startsWith("audio/")) throw IllegalArgumentException("File yang dipilih bukan audio.")
        var name = "alarm"
        var size = 0L
        cr.query(src, arrayOf(OpenableColumns.DISPLAY_NAME, OpenableColumns.SIZE), null, null, null)?.use { c ->
            if (c.moveToFirst()) {
                name = c.getString(0) ?: name
                size = c.getLong(1)
            }
        }
        if (size > 10L * 1024 * 1024) throw IllegalArgumentException("File terlalu besar (maksimal 10 MB).")
 
        val values = ContentValues().apply {
            put(MediaStore.Audio.Media.DISPLAY_NAME, "TimePilot_${System.currentTimeMillis()}_$name")
            put(MediaStore.Audio.Media.MIME_TYPE, mime)
            put(MediaStore.Audio.Media.RELATIVE_PATH, Environment.DIRECTORY_ALARMS + "/TimePilot")
            put(MediaStore.Audio.Media.IS_ALARM, 1)
            put(MediaStore.Audio.Media.IS_PENDING, 1)
        }
        val dest = cr.insert(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, values)
            ?: throw IllegalStateException("Tidak bisa menyimpan suara.")
        try {
            cr.openInputStream(src)!!.use { input ->
                cr.openOutputStream(dest)!!.use { output -> input.copyTo(output) }
            }
            val done = ContentValues().apply { put(MediaStore.Audio.Media.IS_PENDING, 0) }
            cr.update(dest, done, null, null)
        } catch (e: Exception) {
            cr.delete(dest, null, null)
            throw e
        }
        return mapOf("uri" to dest.toString(), "name" to name)
    }
 
    private fun stopPreview() {
        previewHandler.removeCallbacksAndMessages(null)
        preview?.stop()
        preview = null
    }

    private val screenOffReceiver = object : BroadcastReceiver() {
        override fun onReceive(context: Context?, intent: Intent?) {
            if (alarmMode) return
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O_MR1) {
                setShowWhenLocked(false)
                setTurnScreenOn(false)
            } else {
                moveTaskToBack(true)
            }
        }
    }

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "time_pilot/lockscreen")
            .setMethodCallHandler { call, result ->
                if (call.method == "leave") {
                    leaveAlarmMode()
                    result.success(null)
                } else {
                    result.notImplemented()
                }
            }
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "time_pilot/alarm_sound")
            .setMethodCallHandler { call, result ->
                when (call.method) {
                    "pickAndImport" -> {
                        if (pendingPick != null) {
                            result.error("BUSY", "Pemilih file sedang terbuka.", null)
                        } else {
                            pendingPick = result
                            pickAudio.launch(arrayOf("audio/*"))
                        }
                    }
                    "preview" -> {
                        stopPreview()
                        val uri = Uri.parse(call.argument<String>("uri"))
                        val r = RingtoneManager.getRingtone(this, uri)
                        if (r == null) {
                            result.error("PREVIEW_FAILED", "Suara tidak bisa diputar.", null)
                        } else {
                            r.audioAttributes = AudioAttributes.Builder()
                                .setUsage(AudioAttributes.USAGE_ALARM)
                                .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
                                .build()
                            r.play()
                            preview = r
                            previewHandler.postDelayed({ stopPreview() }, 5000)
                            result.success(null)
                        }
                    }
                    "stopPreview" -> {
                        stopPreview()
                        result.success(null)
                    }
                    "remove" -> {
                        try {
                            contentResolver.delete(Uri.parse(call.argument<String>("uri")), null, null)
                        } catch (_: Exception) {
                        }
                        result.success(null)
                    }
                    else -> result.notImplemented()
                }
            }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        alarmMode = isLocked()
        allowOverLockScreen()
        registerReceiver(screenOffReceiver, IntentFilter(Intent.ACTION_SCREEN_OFF))
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        alarmMode = isLocked()
        allowOverLockScreen()
    }

    override fun onDestroy() {
        try {
            unregisterReceiver(screenOffReceiver)
        } catch (_: Exception) {
        }
        stopPreview()
        super.onDestroy()
    }

    private fun allowOverLockScreen() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O_MR1) {
            setShowWhenLocked(true)
            setTurnScreenOn(true)
        }
    }

    private fun isLocked(): Boolean {
        val km = getSystemService(Context.KEYGUARD_SERVICE) as KeyguardManager
        return km.isKeyguardLocked
    }

    private fun leaveAlarmMode() {
        alarmMode = false
        if (!isLocked()) return
        val km = getSystemService(Context.KEYGUARD_SERVICE) as KeyguardManager
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            km.requestDismissKeyguard(this, object : KeyguardManager.KeyguardDismissCallback() {
                override fun onDismissCancelled() {
                    moveTaskToBack(true)
                }

                override fun onDismissError() {
                    moveTaskToBack(true)
                }
            })
        } else {
            moveTaskToBack(true)
        }
    }
}
</file>

<file path="lib/features/feedback/feedback_page.dart">
import 'dart:typed_data';

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../core/theme/app_theme.dart';
import '../../data/local/models/feedback_entry.dart';
import '../../data/repositories/feedback_repository.dart';
import '../profile/profile_avatar.dart';
import 'feedback_photo_provider.dart';
import 'feedback_providers.dart';

class FeedbackPage extends ConsumerWidget {
  const FeedbackPage({super.key});

  Future<void> _confirmDelete(
    BuildContext context,
    WidgetRef ref,
    FeedbackEntry entry,
  ) async {
    final ok = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Hapus pesan?'),
        content: const Text('Pesan ini akan dihapus untuk semua pengguna.'),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(false),
            child: const Text('Batal'),
          ),
          FilledButton(
            style: FilledButton.styleFrom(
              backgroundColor: AppColors.error,
              minimumSize: const Size(96, 44),
            ),
            onPressed: () => Navigator.of(ctx).pop(true),
            child: const Text('Hapus'),
          ),
        ],
      ),
    );
    if (ok != true) return;
    final error = await ref
        .read(feedbackListProvider.notifier)
        .delete(entry.id);
    if (!context.mounted) return;
    ScaffoldMessenger.of(context)
        .showSnackBar(SnackBar(content: Text(error ?? 'Pesan dihapus.')));
  }

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final list = ref.watch(feedbackListProvider);
    final photos = ref.watch(feedbackPhotosProvider).value ?? const <String, Uint8List>{};

    return Scaffold(
      appBar: AppBar(title: const Text('Kesan Pesan')),
      floatingActionButton: FloatingActionButton.extended(
        onPressed: () => showFeedbackForm(context),
        icon: const Icon(Icons.edit_outlined),
        label: const Text('Tulis'),
      ),
      body: RefreshIndicator(
        onRefresh: () => ref.read(feedbackListProvider.notifier).refresh(),
        child: list.when(
          loading: () => const Center(child: CircularProgressIndicator()),
          error: (e, _) => _Message(
            icon: Icons.cloud_off_outlined,
            text: e is FeedbackException ? e.message : 'Gagal memuat pesan.',
            action: FilledButton(
              style: FilledButton.styleFrom(minimumSize: const Size(160, 48)),
              onPressed: () => ref.invalidate(feedbackListProvider),
              child: const Text('Coba lagi'),
            ),
          ),
          data: (items) {
            if (items.isEmpty) {
              return const _Message(
                icon: Icons.rate_review_outlined,
                text: 'Belum ada kesan & pesan.\nJadilah yang pertama menulis!',
              );
            }
            return ListView.separated(
              physics: const AlwaysScrollableScrollPhysics(),
              padding: const EdgeInsets.fromLTRB(
                AppSpacing.s16,
                AppSpacing.s16,
                AppSpacing.s16,
                96,
              ),
              itemCount: items.length + 1,
              separatorBuilder: (_, _) =>
                  const SizedBox(height: AppSpacing.s12),
              itemBuilder: (context, i) {
                if (i == 0) return const _FeedbackIntro();
                final entry = items[i - 1];
                return _FeedbackCard(
                  entry: entry,
                  photo: photos[entry.id],
                  onEdit: () => showFeedbackForm(context, existing: entry),
                  onDelete: () => _confirmDelete(context, ref, entry),
                );
              },
            );
          },
        ),
      ),
    );
  }
}

class _FeedbackIntro extends StatelessWidget {
  const _FeedbackIntro();

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text('Kesan & Pesan', style: theme.textTheme.headlineSmall),
        const SizedBox(height: AppSpacing.s4),
        Text(
          'Bagikan pengalamanmu agar TimePilot makin baik.',
          style: theme.textTheme.bodySmall,
        ),
      ],
    );
  }
}

class _Message extends StatelessWidget {
  const _Message({required this.icon, required this.text, this.action});

  final IconData icon;
  final String text;
  final Widget? action;

  @override
  Widget build(BuildContext context) {
    return ListView(
      physics: const AlwaysScrollableScrollPhysics(),
      padding: const EdgeInsets.all(AppSpacing.s32),
      children: [
        const SizedBox(height: 80),
        Icon(icon, size: 56, color: AppColors.navInactive),
        const SizedBox(height: AppSpacing.s12),
        Text(text, textAlign: TextAlign.center),
        if (action != null) ...[
          const SizedBox(height: AppSpacing.s16),
          Center(child: action),
        ],
      ],
    );
  }
}

class _FeedbackCard extends StatelessWidget {
  const _FeedbackCard({
    required this.entry,
    required this.photo,
    required this.onEdit,
    required this.onDelete,
  });

  final FeedbackEntry entry;
  final Uint8List? photo;
  final VoidCallback onEdit;
  final VoidCallback onDelete;

  /// Satu bagian isi kartu: garis warna di kiri, judul kecil, lalu teks.
  Widget _block(
    ThemeData theme, {
    required String label,
    required Color color,
    required String text,
  }) {
    return IntrinsicHeight(
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Container(
            width: 3,
            decoration: BoxDecoration(
              color: color,
              borderRadius: BorderRadius.circular(2),
            ),
          ),
          const SizedBox(width: AppSpacing.s12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  label,
                  style: theme.textTheme.labelMedium?.copyWith(
                    color: AppColors.navInactive,
                    letterSpacing: 0.4,
                  ),
                ),
                const SizedBox(height: 2),
                Text(text, style: theme.textTheme.bodyMedium),
              ],
            ),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final initial = entry.author.isEmpty ? '?' : entry.author[0].toUpperCase();
    final time =
        formatFeedbackTime(entry.createdAt) +
        (entry.isEdited ? ' \u00B7 diubah' : '');

    return Container(
      padding: const EdgeInsets.fromLTRB(
        AppSpacing.s16,
        AppSpacing.s12,
        AppSpacing.s8,
        AppSpacing.s16,
      ),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(AppRadius.r24),
        boxShadow: AppShadows.soft,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              // Kartu milikmu memakai foto lokal; kartu orang lain memakai
              // thumbnail dari server, atau inisial bila belum punya foto.
              if (entry.isMine)
                const ProfileAvatar(radius: 20)
              else
                CircleAvatar(
                  radius: 20,
                  backgroundColor: AppColors.navy,
                  backgroundImage: photo == null ? null : MemoryImage(photo!),
                  child: photo != null
                      ? null
                      : Text(
                          initial,
                          style: theme.textTheme.titleSmall?.copyWith(
                            color: Colors.white,
                          ),
                        ),
                ),
              const SizedBox(width: AppSpacing.s12),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      entry.isMine ? '${entry.author} (kamu)' : entry.author,
                      style: theme.textTheme.titleSmall,
                    ),
                    Text(time, style: theme.textTheme.bodySmall),
                  ],
                ),
              ),
              if (entry.isMine)
                PopupMenuButton<String>(
                  icon: const Icon(
                    Icons.more_horiz,
                    color: AppColors.navInactive,
                  ),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(AppRadius.r12),
                  ),
                  onSelected: (v) => v == 'edit' ? onEdit() : onDelete(),
                  itemBuilder: (_) => const [
                    PopupMenuItem(value: 'edit', child: Text('Ubah')),
                    PopupMenuItem(value: 'delete', child: Text('Hapus')),
                  ],
                ),
            ],
          ),
          const SizedBox(height: AppSpacing.s12),
          Padding(
            padding: const EdgeInsets.only(right: AppSpacing.s8),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                _block(
                  theme,
                  label: 'Kesan',
                  color: AppColors.navy,
                  text: entry.impression,
                ),
                const SizedBox(height: AppSpacing.s12),
                _block(
                  theme,
                  label: 'Pesan',
                  color: AppColors.orange,
                  text: entry.message,
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

Future<void> showFeedbackForm(BuildContext context, {FeedbackEntry? existing}) {
  return showModalBottomSheet<void>(
    context: context,
    isScrollControlled: true,
    showDragHandle: true,
    backgroundColor: Colors.white,
    shape: const RoundedRectangleBorder(
      borderRadius: BorderRadius.vertical(top: Radius.circular(AppRadius.r24)),
    ),
    builder: (_) => _FeedbackFormSheet(existing: existing),
  );
}

class _FeedbackFormSheet extends ConsumerStatefulWidget {
  const _FeedbackFormSheet({this.existing});

  final FeedbackEntry? existing;

  @override
  ConsumerState<_FeedbackFormSheet> createState() => _FeedbackFormSheetState();
}

class _FeedbackFormSheetState extends ConsumerState<_FeedbackFormSheet> {
  final _formKey = GlobalKey<FormState>();
  late final _impression = TextEditingController(
    text: widget.existing?.impression,
  );
  late final _message = TextEditingController(text: widget.existing?.message);
  bool _submitting = false;
  String? _error;

  bool get _isEdit => widget.existing != null;

  @override
  void dispose() {
    _impression.dispose();
    _message.dispose();
    super.dispose();
  }

  Future<void> _submit() async {
    if (!(_formKey.currentState?.validate() ?? false)) return;
    setState(() {
      _submitting = true;
      _error = null;
    });
    final notifier = ref.read(feedbackListProvider.notifier);
    final error = _isEdit
        ? await notifier.edit(
            widget.existing!.id,
            _impression.text,
            _message.text,
          )
        : await notifier.create(_impression.text, _message.text);
    if (!mounted) return;
    if (error != null) {
      setState(() {
        _submitting = false;
        _error = error;
      });
      return;
    }
    final messenger = ScaffoldMessenger.of(context);
    Navigator.of(context).pop();
    messenger.showSnackBar(
      SnackBar(
        content: Text(_isEdit ? 'Pesan diperbarui.' : 'Pesan terkirim.'),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    return Padding(
      padding: EdgeInsets.fromLTRB(
        AppSpacing.s16,
        0,
        AppSpacing.s16,
        AppSpacing.s16 + MediaQuery.of(context).viewInsets.bottom,
      ),
      child: SingleChildScrollView(
        child: Form(
          key: _formKey,
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              Text(
                _isEdit ? 'Ubah kesan & pesan' : 'Tulis kesan & pesan',
                style: theme.textTheme.titleLarge,
              ),
              const SizedBox(height: AppSpacing.s4),
              Text(
                'Bantu kami membuat TimePilot lebih baik.',
                style: theme.textTheme.bodySmall,
              ),
              const SizedBox(height: AppSpacing.s16),
              TextFormField(
                controller: _impression,
                enabled: !_submitting,
                maxLines: 3,
                minLines: 2,
                maxLength: feedbackMaxLength,
                textCapitalization: TextCapitalization.sentences,
                decoration: const InputDecoration(
                  labelText: 'Kesan',
                  alignLabelWithHint: true,
                ),
                validator: (v) => validateFeedbackField(v, label: 'Kesan'),
              ),
              const SizedBox(height: AppSpacing.s12),
              TextFormField(
                controller: _message,
                enabled: !_submitting,
                maxLines: 3,
                minLines: 2,
                maxLength: feedbackMaxLength,
                textCapitalization: TextCapitalization.sentences,
                decoration: const InputDecoration(
                  labelText: 'Pesan',
                  alignLabelWithHint: true,
                ),
                validator: (v) => validateFeedbackField(v, label: 'Pesan'),
              ),
              if (_error != null) ...[
                const SizedBox(height: AppSpacing.s8),
                Text(
                  _error!,
                  style: const TextStyle(color: AppColors.error, fontSize: 13),
                ),
              ],
              const SizedBox(height: AppSpacing.s16),
              FilledButton(
                onPressed: _submitting ? null : _submit,
                child: _submitting
                    ? const SizedBox(
                        height: 20,
                        width: 20,
                        child: CircularProgressIndicator(
                          strokeWidth: 2,
                          color: Colors.white,
                        ),
                      )
                    : Text(_isEdit ? 'Simpan perubahan' : 'Kirim'),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
